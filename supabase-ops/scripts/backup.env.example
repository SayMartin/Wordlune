# Copy to backup.env ON THE SERVER and fill in. Never commit the filled-in file —
# .gitignore covers `.env`, but this one is named differently, so it is listed
# there explicitly too.

# ─── Supabase database ───────────────────────────────────────────────────────
# From the Supabase dashboard: Project Settings → Database → Connection string.
#
# Use the SESSION POOLER (port 5432), not the transaction pooler (6543):
# transaction mode has no prepared statements and pg_dump fails against it. The
# direct connection (db.<ref>.supabase.co) is IPv6-only on newer projects and
# will not resolve from an IPv4-only home server.
#
# Note the username shape — the pooler needs the project ref appended:
#   PG_USER=postgres.abcdefghijklmnop
PG_HOST=                      # e.g. aws-0-eu-north-1.pooler.supabase.com
PG_PORT=5432
PG_USER=                      # postgres.<project-ref>
PG_DB=postgres
PG_PASSWORD=                  # database password (NOT the anon or service-role key)

# pg_dump refuses to dump from a server newer than itself. Check the instance
# with `select version();` and raise this if Supabase is ahead of it.
PG_IMAGE=postgres:17-alpine

# ─── Cloudflare R2 — backup bucket ───────────────────────────────────────────
# A DEDICATED bucket with its OWN token, scoped to this bucket only and set to
# `Object Read & Write` (never `Admin Read & Write`). That way the nightly job
# cannot reach anything else in the account. No Custom Domain on this bucket —
# database dumps must never be publicly reachable.
#
# The bucket is EU-jurisdiction, so the endpoint needs the `.eu.` form. A
# jurisdictional bucket is invisible on the plain <account-id>.r2.cloudflarestorage.com
# address and fails exactly as if it did not exist.
S3_ENDPOINT=                  # https://<account-id>.eu.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
BACKUP_BUCKET=              # the dedicated backup bucket's name

# ─── Encryption ──────────────────────────────────────────────────────────────
# age PUBLIC key (starts age1...). Generate the pair somewhere that is NOT this
# server:
#
#   age-keygen -o wordlune-backup.key
#
# Put the private key in your password manager, and only the public recipient
# line below on the server. The server can then encrypt backups but never read
# them — which is the whole point.
#
# ORDER MATTERS. Restore a backup with the key before you delete the local key
# file, not after. A key that has never decrypted anything is an assumption, and
# the moment you find out it was the wrong one is the moment you needed it. If
# the file is already gone, `age-keygen -y <file>` on a copy restored from the
# password manager proves it matches the AGE_RECIPIENT below.
#
# Restoring:
#
#   age --decrypt -i wordlune-backup.key wordlune-….dump.age > restore.dump
#   pg_restore --no-owner --no-privileges -d "<target-db-url>" restore.dump
AGE_RECIPIENT=

# ─── Local copies ────────────────────────────────────────────────────────────
# Convenience only; the copy that matters is the one in R2. Remote retention is
# an R2 lifecycle rule on the bucket, not this script's job.
BACKUP_DIR=/home/martin/backups/wordlune
KEEP_LOCAL=7
